// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  description     String?
  categoryId      String?
  isFree          Boolean       @default(false)
  price           Decimal?      @db.Decimal(10, 2)
  currency        String        @default("USD")
  fileKey         String?       // S3 key - private, never exposed publicly
  fileSizeBytes   BigInt?
  fileFormat      String?       // dwg, dxf, skp, etc.
  cadVersion      String?       // e.g. AutoCAD 2018
  previewImageKey String?       // watermarked, public
  thumbnailKey    String?       // small public preview
  downloadCount   Int           @default(0)
  status          ProductStatus @default(DRAFT)
  paddlePriceId   String?       // Paddle Price ID e.g. pri_xxxxx (required for paid products)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  productTags    ProductTag[]
  orderItems     OrderItem[]
  downloadTokens DownloadToken[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String?

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@index([slug])
}

model Tag {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  productTags ProductTag[]

  @@index([slug])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Order {
  id            String      @id @default(uuid())
  paddleOrderId String?     @unique
  email         String
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @db.Decimal(10, 2)
  currency      String      @default("USD")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orderItems OrderItem[]

  @@index([email])
  @@index([status])
  @@index([paddleOrderId])
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  productId       String
  priceAtPurchase Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  downloadTokens DownloadToken[]
}

model DownloadToken {
  id          String    @id @default(uuid())
  orderItemId String?
  productId   String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])

  @@index([token])
  @@index([expiresAt])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
